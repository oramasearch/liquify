# Generated from the built-in registry by liquify docs keymap.
# Copy individual bind records into settings.liquid to override them.

keymap {
    bind "file.close" {
        keys: ["Primary+W"]
    }
    bind "file.save" {
        keys: ["Primary+S"]
    }
    bind "edit.command-palette" {
        keys: ["Primary+Shift+P"]
    }
    bind "edit.select-all" {
        keys: ["Primary+A"]
    }
    bind "edit.toggle-input-mode" {
        keys: ["Primary+M"]
    }
    bind "selection.expand" {
        keys: ["Primary+Shift+Right"]
    }
    bind "selection.shrink" {
        keys: ["Primary+Shift+Left"]
    }
    bind "selection.enclosing-definition" {
        keys: ["Primary+Shift+D"]
    }
    bind "selection.symbol-references" {
        keys: ["Primary+Alt+F"]
    }
    bind "view.toggle-sidebar" {
        keys: ["Primary+B"]
    }
    bind "view.toggle-bottom-panel" {
        keys: ["Primary+J"]
    }
    bind "view.toggle-editor-split" {
        keys: ["Primary+Backslash"]
    }
    bind "view.cycle-theme" {
        keys: ["Primary+Shift+T"]
    }
    bind "go.definition" {
        keys: ["F12"]
    }
    bind "go.hover" {
        keys: ["F1"]
    }
    bind "go.completion" {
        keys: ["Primary+Space"]
    }
    bind "refactor.rename" {
        keys: ["Primary+Shift+R"]
    }
    bind "refactor.extract-function" {
        keys: ["Primary+Shift+X"]
    }
    bind "run.build" {
        keys: ["F7"]
    }
    bind "run.tests" {
        keys: ["F8"]
    }
    bind "run.deploy" {
        keys: ["F9"]
    }
    bind "review.next-hunk" {
        keys: ["Alt+Down"]
    }
    bind "review.previous-hunk" {
        keys: ["Alt+Up"]
    }
    bind "review.next-comment" {
        keys: ["Alt+C"]
    }
    bind "review.new-comment" {
        keys: ["Primary+Alt+C"]
    }
    bind "review.approve" {
        keys: ["Primary+Alt+A"]
    }
    bind "assistant.ask" {
        keys: ["Primary+Shift+A"]
    }
    bind "assistant.explain-diagnostic" {
        keys: ["Primary+Shift+E"]
    }
    bind "assistant.propose-edit" {
        keys: ["Primary+Shift+I"]
    }
    bind "assistant.accept-edit" {
        keys: ["Primary+Enter"]
    }
    bind "assistant.reject-edit" {
        keys: ["Primary+Backspace"]
    }
    bind "assistant.toggle" {
        keys: ["Primary+Shift+L"]
    }
    bind "edit.find" {
        keys: ["Primary+F"]
    }
    bind "edit.focus-search" {
        keys: ["Primary+Shift+F"]
    }
    bind "edit.undo" {
        keys: ["Primary+Z"]
    }
    bind "edit.redo" {
        keys: ["Primary+Shift+Z"]
    }
    bind "selection.line" {
        keys: ["Primary+L"]
    }
    bind "selection.add-cursor-up" {
        keys: ["Primary+Alt+Up"]
    }
    bind "selection.add-cursor-down" {
        keys: ["Primary+Alt+Down"]
    }
    bind "settings.open" {
        keys: ["Primary+Comma"]
    }
    bind "assistant.preview-context" {
        keys: ["Primary+Shift+C"]
    }
}
